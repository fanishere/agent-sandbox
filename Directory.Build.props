<Project>
  <PropertyGroup>
    <!-- Change this single line if you are on a different SDK (e.g. net8.0 or net9.0).
         If you do, also adjust the Microsoft.AspNetCore.Mvc.Testing version in the test project. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
